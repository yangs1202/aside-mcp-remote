# Optional path when `aside` is not on PATH.
# ASIDE_BIN=/path/to/aside

PORT=8766
MCP_REQUEST_TIMEOUT_SECONDS=180
MCP_BEARER_TOKEN=replace-with-a-long-random-token
# MCP_CORS_ORIGIN=https://your-client.example
OPENAI_MODEL=aside-browser
OPENAI_PROGRESS_MESSAGE=요청을 처리하고 있어요.
TASK_START_TIMEOUT_SECONDS=30
# HOST_TASK_STATE_DB=/Users/you/.aside-mcp-remote/tasks.db
# ASIDE_ACCOUNT=u0
# ASIDE_STATE_DIR=/Users/you/.aside/u
